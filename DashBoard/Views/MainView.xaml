<Window
    x:Class="DashBoard.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:DashBoard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:DashBoard.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashBoard.ViewModels"
    Title="MainView"
    Width="1300"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <ctrl:HomeControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CustomerViewModel}">
            <ctrl:CustomerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:IntroLauncherViewModel}">
            <ctrl:IntroLauncherControl />
        </DataTemplate>
    </Window.Resources>

    <Border
        BorderThickness="1"
        CornerRadius="10"
        Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource winBorderColor1}" />
                <GradientStop Offset="0.5" Color="{StaticResource winBorderColor2}" />
                <GradientStop Offset="1" Color="{StaticResource winBorderColor3}" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <!--  Navigation menu  -->
                <ColumnDefinition Width="250" />
                <!--  Content Section  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Navigation Menu  -->

            <ctrl:NavigationControl Grid.Column="0" DataContext="{Binding NavigationViewModel}" />

            <!--  Main Section  -->
            <Border
                Grid.Column="1"
                ClipToBounds="True"
                CornerRadius="0, 10, 10, 0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="{StaticResource deepMidnightBlue1}" />
                        <GradientStop Offset="1" Color="{StaticResource deepMidnightBlue2}" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <!--  Control bar  -->
                        <RowDefinition Height="25" />

                        <!--  Content Section / Child Views  -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Control bar  -->
                    <StackPanel
                        x:Name="pnlControlBar"
                        Grid.Row="0"
                        Margin="0,0,5,0"
                        Background="Transparent"
                        FlowDirection="RightToLeft"
                        MouseEnter="pnlControlBar_MouseEnter"
                        MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                        Orientation="Horizontal">

                        <Button
                            x:Name="btnClose"
                            Click="btnClose_Click"
                            Style="{StaticResource controlButton}"
                            Tag="{StaticResource ColorBrush4}">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}" />
                        </Button>

                        <Button
                            x:Name="btnMaximze"
                            Click="btnMaximze_Click"
                            Style="{StaticResource controlButton}"
                            Tag="{StaticResource ColorBrush8}">
                            <fa:IconImage
                                Width="12"
                                Icon="WindowMaximize"
                                Style="{StaticResource controlButtonIcon}" />
                        </Button>

                        <Button
                            x:Name="btnMinimize"
                            Click="btnMinimize_Click"
                            Style="{StaticResource controlButton}"
                            Tag="{StaticResource ColorBrush6}">
                            <fa:IconImage Icon="WindowMinimize" Style="{StaticResource controlButtonIcon}" />
                        </Button>

                    </StackPanel>



                    <!--  Content Section / Child Views  -->
                    <ContentControl
                        Grid.Row="2"
                        Margin="25"
                        Content="{Binding CurrentChildViewModel}" />

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
