<UserControl
    x:Class="DashBoard.Views.UI.HospitalInfoUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:DashBoard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashBoard.Views.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="250"
    mc:Ignorable="d">
    <Grid>
        <Border Grid.Column="0" CornerRadius="10, 0, 0, 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                    <GradientStop Offset="0" Color="{StaticResource twilightIndigoBackColor1}" />
                    <GradientStop Offset="1" Color="{StaticResource twilightIndigoBackColor2}" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <!--  Logo  -->
                <StackPanel
                    Height="35"
                    Margin="15,25,15,15"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="{StaticResource titleColorBrush2}"
                        Text="Dashboard" />
                </StackPanel>

                <!--  Hopital Infomation  -->
                <Border
                    Margin="15"
                    Padding="5"
                    Background="#EEE5FF"
                    BorderBrush="#E0E0E0"
                    BorderThickness="2"
                    CornerRadius="12">
                    <Grid>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <StackPanel Width="220">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="Gray"
                                    Text="현재 병원" />
                                <ctrl:WatermarkTextBox
                                    BoxBorderThickness="0"
                                    BoxFontFamily="Comic Sans MS"
                                    BoxFontSize="24"
                                    BoxFontWeight="SemiBold"
                                    Foreground="#5A1CEB"
                                    IsTabStop="False"
                                    Text="{Binding HospitalInfo}"
                                    Watermark="병원 이름을 입력해주세요" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Login Information  -->
                <StackPanel
                    Margin="15"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical">
                    <ctrl:WatermarkTextBox
                        BoxBackground="#EEE5FF"
                        BoxBorderThickness="2"
                        Text="{Binding Id}"
                        Watermark="아이디를 입력해주세요" />
                    <ctrl:WatermarkTextBox
                        BoxBackground="#EEE5FF"
                        BoxBorderThickness="2"
                        Text="{Binding Password}"
                        Watermark="비밀번호를 입력해주세요" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
