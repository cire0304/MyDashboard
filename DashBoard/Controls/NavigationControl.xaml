<UserControl
    x:Class="DashBoard.Controls.NavigationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:DashBoard.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DashBoard.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border Grid.Column="0" CornerRadius="10, 0, 0, 10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Offset="0" Color="{StaticResource secondaryBackColor1}" />
                <GradientStop Offset="1" Color="{StaticResource secondaryBackColor2}" />
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel>
            <!--  Logo  -->
            <StackPanel
                Height="35"
                Margin="15,25,0,40"
                Orientation="Horizontal">
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="{StaticResource titleColor2}"
                    Text="Dashboard" />
            </StackPanel>

            <!--  Menu Button  -->
            <RadioButton
                Command="{Binding ToHomeCommand}"
                Style="{StaticResource menuButton}"
                Tag="{StaticResource color1}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" />
                    <TextBlock Style="{StaticResource menuButtonText}" Text="Home" />
                </StackPanel>
            </RadioButton>

            <RadioButton
                Command="{Binding ToCustomerCommand}"
                Style="{StaticResource menuButton}"
                Tag="{StaticResource color2}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="UserGroup" Style="{StaticResource menuButtonIcon}" />
                    <TextBlock Style="{StaticResource menuButtonText}" Text="Users" />
                </StackPanel>
            </RadioButton>

        </StackPanel>
    </Border>

</UserControl>
