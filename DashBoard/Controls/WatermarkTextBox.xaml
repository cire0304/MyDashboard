<UserControl
    x:Class="DashBoard.Controls.WatermarkTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashBoard.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="WatermarkTextBoxStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="{Binding BoxBorderThickness, ElementName=root}" />
            <Setter Property="Background" Value="{Binding BoxBackground, ElementName=root}" />
        </Style>

        <Storyboard x:Key="txtGotFocus">
            <ColorAnimation
                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="#5A1CEB"
                Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="txtLostFocus">
            <ColorAnimation
                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="Gray"
                Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="WatermarkUp">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.15" />
        </Storyboard>

        <Storyboard x:Key="WatermarkDown">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.15" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="2">
        <!--  Border  -->
        <Border x:Name="Border" Style="{StaticResource WatermarkTextBoxStyle}">
            <Grid Margin="5">

                <!--  Watermark  -->
                <TextBlock
                    x:Name="WatermarkText"
                    Padding="0,5,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{Binding BoxFontFamily, ElementName=root}"
                    FontSize="{Binding BoxFontSize, ElementName=root}"
                    FontWeight="{Binding BoxFontWeight, ElementName=root}"
                    Foreground="Gray"
                    RenderTransformOrigin="0.0,0.5"
                    Text="{Binding Watermark, ElementName=root}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <!--  텍스트 값이 입력 안되어 있으면, 워터마크 텍스트 표시  -->
                                <DataTrigger Binding="{Binding Text, ElementName=txt}" Value="">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=txt}" Value="{x:Null}">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  TextBox  -->
                <TextBox
                    x:Name="txt"
                    Padding="0,5,0,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="Transparent"
                    FontFamily="{Binding BoxFontFamily, ElementName=root}"
                    FontSize="{Binding BoxFontSize, ElementName=root}"
                    FontWeight="{Binding BoxFontWeight, ElementName=root}"
                    Foreground="{StaticResource plainTextColor3}"
                    GotFocus="txt_GotFocus"
                    LostFocus="txt_LostFocus"
                    Text="{Binding Text, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="txt_TextChanged" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
