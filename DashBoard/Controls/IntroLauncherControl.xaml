<UserControl
    x:Class="DashBoard.Controls.IntroLauncherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converts="clr-namespace:DashBoard.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashBoard.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converts:ExeIconConverter x:Key="ExeIconConverter" />

        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Margin" Value="10" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                    <GradientStop Offset="0" Color="{StaticResource twilightShadowBackColor1}" />
                    <GradientStop Offset="1" Color="{StaticResource twilightShadowBackColor2}" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel
                Grid.Row="0"
                Width="150"
                Margin="10,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <local:WatermarkTextBox Text="{Binding Id}" Watermark="아이디를 입력해주세요" />
                <local:WatermarkTextBox Text="{Binding Password}" Watermark="비밀번호를 입력해주세요" />

            </StackPanel>
        </Border>

        <!--  ItemsControl을 WrapPanel로 배치하여 아이콘을 가로/세로로 나열  -->
        <Border Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                    <GradientStop Offset="0" Color="{StaticResource deepMidnightBackColor1}" />
                    <GradientStop Offset="1" Color="{StaticResource deepMidnightBackColor2}" />
                </LinearGradientBrush>
            </Border.Background>

            <ItemsControl ItemsSource="{Binding Programs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--  각 앱을 나타내는 버튼  -->
                        <Button
                            Command="{Binding DataContext.StartProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource programButton}">
                            <StackPanel Opacity="1">

                                <!--  아이콘 이미지  -->
                                <Image
                                    Width="64"
                                    Height="64"
                                    Opacity="1"
                                    Source="{Binding Path, Converter={StaticResource ExeIconConverter}}" />
                                <!--  앱 이름  -->
                                <TextBlock
                                    Padding="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="montserrat"
                                    FontWeight="Medium"
                                    Foreground="Gray"
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>

</UserControl>
